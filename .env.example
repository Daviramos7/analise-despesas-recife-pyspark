# Copie para .env (que NÃO vai pro git) e deixe descomentada SÓ UMA opção.

# --- Opção 1 (padrão): Ollama local, grátis, sem chave
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# --- Opção 2: Google Gemini (nuvem, plano gratuito, sem cartão)
# Chave em https://aistudio.google.com -> Get API key. Confira o nome do modelo disponível lá.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=coloque_sua_chave_aqui

# --- Opção 3: Groq (nuvem, plano gratuito). Chave em https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=coloque_sua_chave_aqui
